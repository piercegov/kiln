{
  "name": "kiln-ecs",
  "version": "0.1.2",
  "description": "A thin, agent-first ECS game runtime on Three.js and Koota.",
  "license": "MIT",
  "keywords": [
    "game-engine",
    "ecs",
    "threejs",
    "webgpu",
    "koota",
    "agents",
    "gamedev"
  ],
  "homepage": "https://kilnjs.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piercegov/kiln.git",
    "directory": "packages/kiln"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts"
  },
  "bin": {
    "kiln": "./src/cli/kiln.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/plugins/render/index.ts",
    "./input": "./src/plugins/input/index.ts",
    "./assets": "./src/plugins/assets/index.ts",
    "./debug": "./src/plugins/debug/index.ts",
    "./physics": "./src/plugins/physics/index.ts",
    "./timer": "./src/plugins/timer/index.ts",
    "./tween": "./src/plugins/tween/index.ts",
    "./ui": "./src/plugins/ui/index.ts",
    "./camera": "./src/plugins/camera/index.ts",
    "./save": "./src/plugins/save/index.ts",
    "./animation": "./src/plugins/animation/index.ts",
    "./test": "./src/test/index.ts",
    "./vite": "./src/tooling/vite.ts",
    "./preload": "./src/tooling/preload.ts",
    "./names": "./src/tooling/names.ts",
    "./browser": "./src/browser.ts"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22"
  },
  "dependencies": {
    "koota": "0.6.6",
    "tweakpane": "4.0.5"
  },
  "peerDependencies": {
    "three": "0.186.1",
    "vite": "8.3.4",
    "playwright-core": "1.64.1",
    "@dimforge/rapier2d-compat": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "@dimforge/rapier2d-compat": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/bun": "1.4.3",
    "@types/three": "0.186.0",
    "playwright-core": "1.64.1",
    "three": "0.186.1",
    "typescript": "5",
    "vite": "8.3.4"
  }
}
